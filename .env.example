# Configuración para DESARROLLO LOCAL (clases y evaluación).
# Copie este archivo como .env:   cp .env.example .env   (Windows: copy .env.example .env)
# No necesita cambiar nada para que el proyecto funcione.
# .env nunca se sube al repositorio.

# true = modo desarrollo: http://127.0.0.1:8000, sin HTTPS, con páginas de error detalladas.
# No lo cambie a false en su computador: false es el modo producción (ver DESPLIEGUE.md).
DJANGO_DEBUG=true

# --- Opcional ---------------------------------------------------------------
# Para enviar correos reales desde el CRM con Gmail (contraseña de aplicación).
# Si se dejan vacíos, los correos se muestran en la terminal donde corre runserver.
GMAIL_USUARIO=
GMAIL_CONTRASENA_APLICACION=

# Datos de contacto que muestra el portal público.
EMPRESA_TELEFONO=
EMPRESA_EMAIL=

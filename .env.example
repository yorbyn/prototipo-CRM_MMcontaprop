# Copie este archivo como .env (Windows: copy .env.example .env) y complete la SECRET_KEY.
# El archivo .env nunca se sube al repositorio.
#
# Para generar una SECRET_KEY nueva:
#   py -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY='tu-clave-secreta-aqui'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Opcional ---------------------------------------------------------------
# Para enviar correos reales desde el CRM con Gmail (contraseña de aplicación).
# Si se dejan vacíos, los correos se muestran en la terminal donde corre runserver.
GMAIL_USUARIO=
GMAIL_CONTRASENA_APLICACION=

# Datos de contacto que muestra el portal público.
EMPRESA_TELEFONO=
EMPRESA_EMAIL=
